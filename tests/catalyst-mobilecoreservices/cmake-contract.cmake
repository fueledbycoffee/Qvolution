function(project)
endfunction()
function(add_framework name)
  if(NOT name STREQUAL "MobileCoreServices")
    message(FATAL_ERROR "wrong framework name")
  endif()
  set(args ${ARGN})
  foreach(required IOSSUPPORT FAT CURRENT_VERSION LaunchServices)
    if(NOT required IN_LIST args)
      message(FATAL_ERROR "missing ${required}")
    endif()
  endforeach()
  list(FIND args VERSION version_index)
  math(EXPR version_index "${version_index}+1")
  list(GET args ${version_index} version)
  if(NOT version STREQUAL "A")
    message(FATAL_ERROR "wrong framework version")
  endif()
endfunction()
function(reexport from to path)
  if(NOT from STREQUAL "MobileCoreServices" OR NOT to STREQUAL "LaunchServices" OR NOT path MATCHES "/CoreServices/src/LaunchServices/LaunchServices$")
    message(FATAL_ERROR "wrong reexport: ${from};${to};${path}")
  endif()
  set(reexport_seen TRUE PARENT_SCOPE)
endfunction()
cmake_policy(SET CMP0057 NEW)
include("${CMAKE_CURRENT_LIST_DIR}/../../src/frameworks/MobileCoreServices/CMakeLists.txt")
if(NOT reexport_seen)
  message(FATAL_ERROR "missing reexport")
endif()
